POSTGRES_DB=mathvid
POSTGRES_USER=mathvid
POSTGRES_PASSWORD=mathvid
DATABASE_URL=postgresql+psycopg://mathvid:mathvid@postgres:5432/mathvid
REDIS_URL=redis://redis:6379/0
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOCAL_ASSET_ROOT=/data/assets
LOCAL_RENDER_ROOT=/data/renders
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:latest
TTS_PROVIDER=piper
DEFAULT_BGM_DIR=/data/bgm

# ── YouTube (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID) ──────
# 1. Create project at console.cloud.google.com
# 2. Enable YouTube Data API v3
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add redirect URI: http://localhost:8000/api/platforms/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/platforms/youtube/callback

# ── Instagram (developers.facebook.com → Your App → Instagram Graph API) ───────────────────────
# 1. Create a Facebook App
# 2. Add Instagram Graph API product
# 3. Connect your Instagram Business or Creator account
# 4. Generate a long-lived User Access Token
# 5. Find your Instagram User ID (the numeric ID, not username)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
